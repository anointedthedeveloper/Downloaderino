{
  "buildCommand": "pnpm --filter @workspace/downloaderino run build",
  "outputDirectory": "artifacts/downloaderino/dist/public",
  "installCommand": "pnpm install",
  "rewrites": [
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/api/proxy/:path*", "destination": "https://movie-api-nine-chi.vercel.app/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
